{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal site and blog — henriqueartur.com",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "preview:pages": "astro build && bun tools/serve-pages.mjs",
    "fmt": "biome check --write .",
    "check:style": "biome ci --error-on-warnings .",
    "check:types": "astro sync && tsc --noEmit",
    "check:arch": "archwarden check",
    "check": "bun run check:style && bun run check:types && bun run check:arch",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:a11y": "astro build && bun tools/audit-a11y.mjs",
    "verify": "bun run check && bun run test && bun run build",
    "prepare": "husky"
  },
  "dependencies": {
    "astro": "7.1.6",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@gltf-transform/cli": "4.4.2",
    "@types/three": "0.185.2",
    "archwarden": "0.5.1",
    "husky": "9.1.7",
    "sharp": "0.35.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
