---
interface Props {
  /** Texto alternativo do fallback. Decorativo por padrão. */
  label?: string;
}

const { label } = Astro.props;
const modelUrl = '/models/terrarium.glb';
---

<div class="terrarium" data-model={modelUrl}>
  {/*
    O fallback está sempre no HTML e é o que todo mundo recebe primeiro. O canvas
    só aparece se o modelo carregar de verdade — quem tem reduced-motion, quem
    pediu economia de dados, quem não tem WebGL e quem está numa tela minúscula
    ficam com este desenho, que não é um erro nem um placeholder: é a versão
    daquele ambiente.
  */}
  <svg
    class="terrarium__fallback"
    viewBox="0 0 200 200"
    role={label ? 'img' : 'presentation'}
    aria-label={label}
    aria-hidden={label ? undefined : 'true'}
  >
    <g fill="none" stroke="currentColor" stroke-width="1.25">
      <path d="M60 120 A40 40 0 0 1 140 120" />
      <path d="M60 120 h80" />
      <path d="M56 120 h88 v14 h-88 z" />
      <path d="M64 134 h72 v10 h-72 z" />
      <ellipse cx="100" cy="120" rx="40" ry="9" opacity="0.55" />
      <path d="M100 80 v40" opacity="0.35" stroke-dasharray="3 4" />
      <path d="M60 120 h-14" opacity="0.5" stroke-dasharray="3 4" />
      <path d="M140 120 h14" opacity="0.5" stroke-dasharray="3 4" />
      <path d="M86 112 q6 -14 14 -6 q8 -10 14 6" opacity="0.7" />
    </g>
  </svg>

  <canvas class="terrarium__canvas" aria-hidden="true" tabindex="-1"></canvas>
</div>

<script>
  import { shouldRender3d } from '../scripts/three/should-render-3d.ts';
  import type { ViewerHandle } from '../scripts/three/viewer.ts';

  function hasWebGL(): boolean {
    try {
      const probe = document.createElement('canvas');
      return Boolean(probe.getContext('webgl2') ?? probe.getContext('webgl'));
    } catch {
      return false;
    }
  }

  function saveDataEnabled(): boolean {
    const connection = (navigator as { connection?: { saveData?: boolean } }).connection;
    return connection?.saveData === true;
  }

  for (const root of document.querySelectorAll<HTMLElement>('.terrarium')) {
    const canvas = root.querySelector('canvas');
    const modelUrl = root.dataset.model;
    if (!canvas || !modelUrl) continue;

    const allowed = shouldRender3d({
      reducedMotion: matchMedia('(prefers-reduced-motion: reduce)').matches,
      hasWebGL: hasWebGL(),
      viewportWidth: window.innerWidth,
      saveData: saveDataEnabled(),
    });

    if (!allowed) continue;

    let viewer: ViewerHandle | null = null;
    let loading = false;

    const visibility = new IntersectionObserver(async (entries) => {
      const visible = entries.some((entry) => entry.isIntersecting);

      if (!visible) {
        viewer?.pause();
        return;
      }

      if (viewer) {
        viewer.resume();
        return;
      }

      if (loading) return;
      loading = true;

      try {
        // O three.js só entra na rede aqui: depois de a decisão ter sido tomada
        // e de o elemento estar de fato à vista.
        const { mountViewer } = await import('../scripts/three/viewer.ts');
        viewer = await mountViewer({ canvas, modelUrl });
        root.dataset.state = 'ready';
      } catch {
        // Modelo ausente, rede caída, GPU recusando o contexto: o fallback já
        // está na tela e continua sendo a resposta certa. Nada a fazer.
        visibility.disconnect();
      } finally {
        loading = false;
      }
    });

    visibility.observe(root);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) viewer?.pause();
      else viewer?.resume();
    });
  }
</script>

<style>
  /*
   * MOBILE — sangria de borda a borda.
   *
   * Em coluna única, um objeto contido pela margem fica pequeno demais para
   * justificar o que custa baixar. Sangrando, ele vira o elemento visual do
   * topo. As margens negativas cancelam o padding do `.shell`.
   *
   * Proporção 5/4 e não quadrada: quadrado em largura total ocuparia uma tela
   * inteira de altura e empurraria todo o conteúdo para fora.
   *
   * O objeto passa por cima da seção seguinte — daí o z-index. Sem ele, o
   * fundo da próxima seção pintaria por cima.
   */
  .terrarium {
    position: relative;
    /*
     * 1, e não 2: precisa ficar acima do fundo das seções seguintes — que
     * pintam depois, por ordem do DOM — e abaixo do texto do hero, que sobe
     * para 2 justamente por isso.
     */
    z-index: 1;
    aspect-ratio: 9 / 8;
    width: calc(100% + var(--space-2) * 2);
    margin-inline: calc(-1 * var(--space-2));
    margin-block-end: -4rem;
    color: var(--color-line-strong);
  }

  .terrarium__fallback,
  .terrarium__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .terrarium__canvas {
    opacity: 0;
    transition: opacity 400ms ease;
  }

  /* O canvas só aparece — e o desenho só sai — quando o modelo está de pé. */
  .terrarium[data-state='ready'] .terrarium__canvas {
    opacity: 1;
  }

  .terrarium[data-state='ready'] .terrarium__fallback {
    opacity: 0;
  }

  .terrarium__fallback {
    transition: opacity 400ms ease;
  }

  @media (min-width: 48rem) {
    /*
     * No desktop ele volta a ser contido, mas grande: quase o dobro do que era.
     * A margem negativa deixa a base invadir a seção seguinte, para o objeto
     * não parecer preso dentro do hero.
     */
    .terrarium {
      /* Fica parado enquanto o hero e o começo do Sobre passam por baixo. O
         alcance vem de `.hero__aside`, em Home.astro. */
      position: sticky;
      inset-block-start: 5rem;
      aspect-ratio: 1;
      width: 100%;
      max-width: none;
      margin-inline: 0;
      /* Sobe acima do topo do texto: alinhado, o objeto fica visualmente baixo
         em relação ao hero, porque a coluna de texto começa mais acima. */
      margin-block-start: -11rem;
      /*
       * `--drift` vai de 0 a 1 conforme o objeto fica parado e o texto sobe por
       * baixo dele. 9rem é o quanto ele sai para a direita no fim — o bastante
       * para liberar a coluna de leitura sem sumir da tela.
       */
      transform: translateX(calc(var(--drift, 0) * 9rem));
      transition: transform 120ms linear;
      margin-block-end: -10rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .terrarium__canvas,
    .terrarium__fallback {
      transition: none;
    }
  }
</style>
