---
import type { Surface } from '../lib/design/section-surfaces.ts';

interface Props {
  id: string;
  /** Numeração de planta técnica: "01", "02"... */
  number: string;
  label: string;
  title: string;
  surface: Surface;
  /** Anotação de margem, opcional. Aparece como lembrete a lápis ao lado. */
  note?: string;
}

const { id, number, label, title, surface, note } = Astro.props;
---

<section
  id={id}
  class:list={['section', 'surface', `surface--${surface}`]}
  aria-labelledby={`${id}-title`}
>
  <div class="shell">
    <p class="label section__label reveal">
      <span class="section__number">{number}</span>
      <span class="section__rule" aria-hidden="true"></span>
      {label}
    </p>

    <div class="section__head reveal">
      <h2 id={`${id}-title`} class="section__title">{title}</h2>

      {/* Traço à mão sob o título. Decorativo: o texto já está no h2. */}
      <svg
        class="sketch-rule draw"
        viewBox="0 0 300 10"
        preserveAspectRatio="none"
        aria-hidden="true"
        focusable="false"
      >
        <path
          d="M3 7 C 46 2, 88 9, 132 5 S 214 2, 262 6 S 288 8, 297 4"
          stroke-dasharray="320"
        ></path>
      </svg>

      {note && <p class="margin-note section__note">{note}</p>}
    </div>

    <slot />
  </div>
</section>

<style>
  /*
   * Divisor em TODO limite de seção, e não só onde o fundo muda de tom.
   *
   * `plain` e `grid` compartilham a mesma cor de fundo, então o limite entre
   * elas sumia, enquanto `plain → dots` e qualquer coisa → `inverted` criavam
   * uma borda sozinhas. O resultado era divisor em alguns limites e nenhum em
   * outros — inconsistência que vinha do acaso das cores, não de uma decisão.
   *
   * `lineStrong` foi escolhido por ser o único token que atinge 3:1 nas três
   * superfícies: 3.48 no papel, 3.07 no pontilhado, 4.02 na tinta.
   */
  .section {
    padding-block: var(--space-6);
    border-block-start: 1px solid var(--color-line-strong);
  }

  .shell {
    max-width: var(--layout-max-width);
    padding-inline: var(--space-2);
    margin-inline: auto;
  }

  .section__label {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin-block-end: var(--space-2);
  }

  /* O número é o elemento mais "escrito à mão" da página, então é o que mais
     se permite sair do prumo. */
  .section__number {
    display: inline-block;
    font-weight: 500;
    color: var(--color-accent-deep);
    transform: rotate(-3deg);
  }

  /* O accent comum atinge só 4.11:1 sobre tinta e reprovaria como texto. */
  .surface--inverted .section__number {
    color: var(--color-accent-on-dark);
  }

  .section__rule {
    flex: 0 0 var(--space-3);
    height: 1px;
    background-color: currentColor;
    opacity: 0.5;
  }

  .section__head {
    margin-block-end: var(--space-3);
  }

  .section__title {
    margin-block-end: 0.25rem;
  }

  .section__note {
    margin-block-start: var(--space-1);
  }

  @media (min-width: 48rem) {
    .section {
      padding-block: var(--space-8);
    }

    .shell {
      padding-inline: var(--space-4);
    }
  }
</style>
