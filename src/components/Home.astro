---
import Base from '../layouts/Base.astro';
import { education } from '../lib/content/education.ts';
import { impact } from '../lib/content/impact.ts';
import { openSource } from '../lib/content/open-source.ts';
import { profile } from '../lib/content/profile.ts';
import { projects } from '../lib/content/projects.ts';
import { stack } from '../lib/content/stack.ts';
import { timeline } from '../lib/content/timeline.ts';
import { sectionSurfaces } from '../lib/design/section-surfaces.ts';
import { formatPeriod } from '../lib/i18n/format-period.ts';
import type { Locale } from '../lib/i18n/locales.ts';
import { ui } from '../lib/i18n/ui.ts';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Section from './Section.astro';
import Terrarium from './Terrarium.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { pathname } = Astro.url;

const featured = openSource.find((repo) => repo.featured);
const others = openSource.filter((repo) => !repo.featured);
---

<Base
  title={`${profile.name} — ${profile.role[locale]}`}
  description={profile.tagline[locale]}
  locale={locale}
>
  <header class="hero surface surface--grid">
    <div class="shell">
      <div class="hero__top">
        <p class="label hero__eyebrow">
          {profile.role[locale]} · {profile.location[locale]}
        </p>
        <div class="hero__nav">
          <p class="label">
            <a href={locale === 'en' ? '/en/blog/' : '/blog/'}>{ui.blogLabel[locale]}</a>
          </p>
          <LanguageSwitcher locale={locale} pathname={pathname} />
        </div>
      </div>

      <div class="hero__body">
        <div>
          <h1 class="hero__name">{profile.name}</h1>
          <p class="hero__tagline">{profile.tagline[locale]}</p>

          <nav aria-label={ui.contactLinks[locale]}>
            <ul class="hero__links">
              {
                profile.links.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>

        <Terrarium />
      </div>
    </div>
  </header>

  <main id="conteudo">
      <Section
        id="sobre"
        surface={sectionSurfaces['sobre']}
        number="01"
        label={ui.aboutLabel[locale]}
        title={ui.aboutTitle[locale]}
      >
        <div class="prose">
          {profile.summary.map((paragraph) => <p>{paragraph[locale]}</p>)}
        </div>
      </Section>

      <Section
        id="impacto"
        surface={sectionSurfaces['impacto']}
        note={ui.noteImpact[locale]}
        number="02"
        label={ui.impactLabel[locale]}
        title={ui.impactTitle[locale]}
      >
        <ul class="cards cards--scattered">
          {
            impact.map((item) => (
              <li class="card-enter">
                {/*
                  O cartão é um elemento interno de propósito: a revelação por
                  scroll anima o transform do <li>, e o hover transiciona o
                  transform do <article>. Na mesma caixa os dois disputariam a
                  mesma propriedade, e passar o mouse durante a entrada cortaria
                  a entrada pela metade.
                */}
                <article class="card card--impact">
                  {item.metric && <p class="card__metric">{item.metric[locale]}</p>}
                  <h3 class="card__title">{item.title[locale]}</h3>
                  <p class="card__text">{item.description[locale]}</p>
                </article>
              </li>
            ))
          }
        </ul>
      </Section>

      <Section
        id="projetos"
        surface={sectionSurfaces['projetos']}
        note={ui.noteProjects[locale]}
        number="03"
        label={ui.projectsLabel[locale]}
        title={ui.projectsTitle[locale]}
      >
        <ul class="cards cards--scattered">
          {
            projects.map((project) => (
              <li class="reveal">
                <article class="card card--project">
                  {/*
                    Círculo de marcador, desenhado no hover. `pathLength="100"`
                    normaliza o comprimento do traço: sem isso o dasharray teria
                    que casar com a geometria exata do caminho, e qualquer ajuste
                    no desenho quebraria a animação sem erro nenhum.

                    A curva da esquerda usa x negativo de propósito: ela sai do
                    viewBox para abrir mais raio daquele lado. Só funciona porque
                    o CSS declara `overflow: visible` — com o padrão `hidden` do
                    SVG, esse trecho seria cortado.
                  */}
                  <svg
                    class="circle-mark"
                    viewBox="0 0 200 140"
                    preserveAspectRatio="none"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path
                      pathLength="100"
                      d="M14 21 C56 4, 144 3, 181 21 C199 46, 198 112, 177 130 C127 145, 46 144, 12 124 C-9 98, -8 39, 4 18 C14 9, 40 4, 68 3"
                    />
                  </svg>

                  <h3 class="card__title">{project.name[locale]}</h3>
                  <p class="label card__context">{project.context}</p>
                  <p class="card__text">{project.description[locale]}</p>
                  <ul class="tags">
                    {project.tech.map((tech) => (
                      <li class="tag">{tech}</li>
                    ))}
                  </ul>
                </article>
              </li>
            ))
          }
        </ul>
      </Section>

      <Section
        id="stack"
        surface={sectionSurfaces['stack']}
        note={ui.noteStack[locale]}
        number="04"
        label={ui.stackLabel[locale]}
        title={ui.stackTitle[locale]}
      >
        <dl class="stack tilt-list">
          {
            stack.current.map((group) => (
              <div class="stack__group">
                <dt class="label">{group.label[locale]}</dt>
                <dd>
                  <ul class="tags">
                    {group.items.map((item) => (
                      <li class="tag">{item}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            ))
          }
          <div class="stack__group">
            <dt class="label">{ui.stackPast[locale]}</dt>
            <dd>
              <ul class="tags">
                {stack.past.map((item) => <li class="tag tag--muted">{item}</li>)}
              </ul>
            </dd>
          </div>
        </dl>
      </Section>

      <Section
        id="open-source"
        surface={sectionSurfaces['open-source']}
        number="05"
        label={ui.openSourceLabel[locale]}
        title={ui.openSourceTitle[locale]}
      >
        {
          featured && (
            <article class="featured reveal">
              <h3 class="featured__name">
                <a href={featured.href}>{featured.name}</a>
              </h3>
              <p class="label">{featured.language}</p>
              <p class="featured__text">{featured.description[locale]}</p>
            </article>
          )
        }

        <ul class="cards tilt-list">
          {
            others.map((repo) => (
              <li class="card reveal">
                <h3 class="card__title">
                  <a href={repo.href}>{repo.name}</a>
                </h3>
                <p class="label card__context">{repo.language}</p>
                <p class="card__text">{repo.description[locale]}</p>
              </li>
            ))
          }
        </ul>
      </Section>

      <Section
        id="trajetoria"
        surface={sectionSurfaces['trajetoria']}
        note={ui.noteTimeline[locale]}
        number="06"
        label={ui.timelineLabel[locale]}
        title={ui.timelineTitle[locale]}
      >
        <ol class="timeline tilt-list">
          {
            timeline.map((entry) => (
              <li class="timeline__entry reveal">
                <p class="label timeline__period">{formatPeriod(entry.start, entry.end, locale)}</p>
                <h3 class="timeline__company">{entry.company}</h3>
                <ul class="timeline__roles">
                  {entry.roles.map((role) => (
                    <li>
                      <span class="timeline__role">{role.title[locale]}</span>
                      <span class="timeline__role-period">
                        {formatPeriod(role.start, role.end, locale)}
                      </span>
                    </li>
                  ))}
                </ul>
                {entry.note && <p class="timeline__note">{entry.note[locale]}</p>}
              </li>
            ))
          }
        </ol>
      </Section>

      <Section
        id="formacao"
        surface={sectionSurfaces['formacao']}
        number="07"
        label={ui.educationLabel[locale]}
        title={ui.educationTitle[locale]}
      >
        <ol class="timeline tilt-list">
          {
            education.map((degree) => (
              <li class="timeline__entry reveal">
                <p class="label timeline__period">
                  {formatPeriod(degree.start, degree.end, locale)}
                </p>
                <h3 class="timeline__company">{degree.title[locale]}</h3>
                <p class="timeline__role">{degree.institution}</p>
                {degree.note && <p class="timeline__note">{degree.note[locale]}</p>}
              </li>
            ))
          }
        </ol>
      </Section>

      <Section
        id="contato"
        surface={sectionSurfaces['contato']}
        number="08"
        label={ui.contactLabel[locale]}
        title={ui.contactTitle[locale]}
      >
        <div class="prose">
          <p>{ui.contactLead[locale]}</p>
        </div>
        <ul class="hero__links contact__links">
          {
            profile.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </Section>
  </main>

  <footer class="footer surface surface--plain">
    <div class="shell">
      <p class="label">© {profile.name}</p>
      {/* Atribuição exigida pela CC BY 4.0 do modelo 3D. */}
      <p class="label footer__credit">
        3D: <a href="https://sketchfab.com/3d-models/smol-ame-in-an-upcycled-terrarium-hololiveen-490cecc249d242188fda5ad3160a4b24">Smol Ame in an upcycled terrarium</a>
        {' '}by Seafoam,{' '}
        <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>
      </p>
    </div>
  </footer>
</Base>

<script>
  import { pileProgress, pileState } from '../scripts/motion/pile-state.ts';

  /*
   * Dirige a pilha dos cartões de impacto.
   *
   * A pilha inteira desce um slot por vez e deixa o cartão do topo para trás:
   *
   *   [123456] _ _ _ _ _   →   1 [23456] _ _ _ _   →   1 2 [3456] _ _ _
   *
   * Roda a cada quadro em vez de ser CSS porque cada cartão percorre um número
   * diferente de slots sobre uma mesma linha do tempo — o cartão 6 passa por
   * cinco, o cartão 2 por um. Em CSS isso seria um @keyframes por cartão.
   *
   * Só no mobile: no desktop são duas colunas e a pilha não faz sentido.
   */
  const list = document.querySelector<HTMLElement>('#impacto .cards--scattered');
  const cards = list ? [...list.querySelectorAll<HTMLElement>('.card-enter')] : [];

  if (list && cards.length > 0) {
    const singleColumn = matchMedia('(max-width: 47.99rem)');
    const stillMotion = matchMedia('(prefers-reduced-motion: reduce)');

    // `offsetTop` não muda com a rolagem e transform não altera layout, então a
    // medida vale mesmo com os cartões já deslocados.
    let slots = cards.map((card) => card.offsetTop);
    let scheduled = false;

    // Ordem de pintura da pilha: o primeiro cartão por cima, e fixa. Ela não
    // muda durante o movimento, então é atribuída uma vez e com inteiro.
    cards.forEach((card, index) => {
      card.style.zIndex = String(cards.length - index);
    });

    const release = () => {
      list.classList.remove('js-pile');
      for (const card of cards) {
        card.style.removeProperty('--stack-offset');
        card.style.removeProperty('--stack-depth');
      }
    };

    const apply = () => {
      scheduled = false;

      if (!singleColumn.matches || stillMotion.matches) {
        release();
        return;
      }

      list.classList.add('js-pile');

      const progress = pileProgress(list.getBoundingClientRect(), window.innerHeight);

      pileState(progress, slots).forEach((state, index) => {
        const card = cards[index];
        if (!card) return;
        card.style.setProperty('--stack-offset', `${state.offset}px`);
        card.style.setProperty('--stack-depth', state.depth.toFixed(3));
      });
    };

    const schedule = () => {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(apply);
    };

    const remeasure = () => {
      // Solta a pilha antes de medir: com os cartões deslocados a leitura ainda
      // seria correta, mas soltar também cobre a virada para o desktop.
      release();
      slots = cards.map((card) => card.offsetTop);
      schedule();
    };

    apply();
    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', remeasure, { passive: true });
  }
</script>

<style>
  .shell {
    max-width: var(--layout-max-width);
    padding-inline: var(--space-2);
    margin-inline: auto;
  }

  /* Cartão sobre superfície texturizada precisa de fundo próprio para o texto
     não disputar leitura com a trama por baixo. */
  .card,
  .featured {
    box-shadow: 2px 2px 0 color-mix(in srgb, var(--color-ink) 10%, transparent);
  }

  /* ---------- hero ---------- */

  .hero {
    padding-block: var(--space-4) var(--space-6);
  }

  .hero__top {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    align-items: center;
    justify-content: space-between;
    margin-block-end: var(--space-3);
  }

  .hero__eyebrow {
    margin: 0;
  }

  .hero__nav {
    display: flex;
    gap: var(--space-2);
    align-items: center;
  }

  .hero__name {
    font-size: var(--font-size-3xl);
    margin-block-end: var(--space-2);
  }

  .hero__tagline {
    max-width: 40ch;
    font-size: var(--font-size-lg);
    color: var(--color-ink-soft);
    margin-block-end: var(--space-3);
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    padding: 0;
    list-style: none;
  }

  /* ---------- cartões ---------- */

  .cards {
    display: grid;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .card {
    padding: var(--space-2);
    background-color: var(--color-paper-deep);
    border: 1px solid var(--color-line-strong);
  }

  .card__metric {
    font-family: var(--font-display);
    font-size: var(--font-size-2xl);
    font-weight: 700;
    line-height: var(--line-height-tight);
    color: var(--color-accent-deep);
  }

  .card__title {
    font-size: var(--font-size-lg);
    margin-block-end: var(--space-1);
  }

  .card__context {
    margin-block-end: var(--space-1);
  }

  .card__text {
    font-size: var(--font-size-sm);
  }

  /* ---------- impacto: cartões jogados na mesa ---------- */

  .cards--scattered > li {
    position: relative;
  }

  /*
   * A ordem da pilha é definida em JS, não aqui.
   *
   * A tentação era `z-index: calc(100 - var(--stack-depth))`, mas --stack-depth
   * é fracionário e z-index só aceita inteiro. Valor inválido faz o navegador
   * descartar a declaração, o z-index volta a `auto`, e a pintura cai na ordem
   * do DOM — a pilha aparece por cima do cartão que já assentou, e o defeito
   * pisca conforme o número passa por valores inteiros.
   */

  /*
   * "Jogado" vem principalmente do deslocamento, não da rotação. Inclinar muito
   * um bloco com três linhas de texto cansa a leitura; deslocar não. Por isso a
   * rotação fica em torno de 1,5° e o resto do efeito vem do offset.
   */
  .cards--scattered .card {
    transform: translate(var(--shift-x, 0), var(--shift-y, 0)) rotate(var(--tilt, 0deg));
    /* O cubic-bezier passa de 1 no terceiro parâmetro: a curva ultrapassa o
       destino e volta. É de onde vem a sensação de "mexeu" — sem keyframes, e
       reversível, então sair com o mouse desfaz pelo mesmo caminho. */
    transition:
      transform 300ms cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 300ms ease;
  }

  /* Sob o cursor o cartão vai para o prumo e cresce: sai da pilha bagunçada e
     se apresenta. */
  .cards--scattered > li:hover .card,
  .cards--scattered > li:focus-within .card {
    transform: translate(0, 0) rotate(0deg) scale(1.04);
    box-shadow: 5px 6px 0 color-mix(in srgb, var(--color-ink) 16%, transparent);
  }

  /*
   * Mobile primeiro, e aqui isso muda o desenho, não só a medida.
   *
   * Em coluna única o cartão ocupa a largura toda, então o mesmo ângulo desloca
   * muito mais os cantos — o que era "jogado na mesa" vira "torto". E qualquer
   * deslocamento horizontal empurraria o cartão contra a margem do container.
   *
   * Por isso aqui a rotação é quase imperceptível e o shift-x é zero. O
   * espalhamento de verdade começa a partir de 48rem, onde há duas colunas e
   * sobra folga lateral.
   */
  .cards--scattered > li:nth-child(2n + 1) .card {
    --tilt: -0.4deg;
    --shift-y: 0.1rem;
  }

  .cards--scattered > li:nth-child(2n + 2) .card {
    --tilt: 0.35deg;
    --shift-y: -0.1rem;
  }

  /* Texto menor: o cartão de impacto é leitura de relance, não de fôlego. */
  .card--impact .card__metric {
    font-size: var(--font-size-xl);
  }

  .card--impact .card__title {
    font-size: var(--font-size-base);
  }

  .card--impact .card__text {
    font-size: var(--font-size-xs);
    line-height: 1.55;
  }

  /* ---------- impacto: desempilhar ao rolar (só no mobile) ---------- */

  /*
   * No mobile os cartões entram como se estivessem empilhados: cada um chega
   * de trás e de cima, menor e mais torto, e assenta no lugar conforme rola.
   *
   * Isto substitui o `.reveal` genérico em vez de somar a ele — duas regras
   * `animation` no mesmo elemento não se combinam, a última simplesmente vence.
   * Por isso o <li> usa `card-enter`, e o que muda no breakpoint é só o
   * `animation-name`.
   */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      /* Longhand obrigatório — ver o aviso em global.css. */
      .card-enter {
        animation-name: settle;
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 5% entry 80%;
      }

    }
  }

  /*
   * Pilha dirigida por JS. `animation: none` desliga a versão em CSS, que não
   * consegue expressar este movimento: a pilha desce um slot por vez e cada
   * cartão passa por vários slots, o que exigiria keyframes diferentes por
   * cartão sobre uma linha do tempo compartilhada.
   */
  .js-pile .card-enter {
    animation: none;
    opacity: 1;
    transform: translateY(var(--stack-offset, 0px))
      translateX(calc(var(--stack-depth, 0) * 4px))
      scale(calc(1 - var(--stack-depth, 0) * 0.02))
      rotate(calc(var(--stack-depth, 0) * -1.1deg));
  }

  @keyframes settle {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ---------- projetos: círculo de marcador ---------- */

  .card--project {
    position: relative;
  }

  /*
   * O traço fica FORA do cartão, com inset negativo: marcador de quadro circula
   * em volta do que destaca, não por dentro.
   *
   * Largura e altura são explícitas, e não `auto`. O reset global aplica
   * `height: auto` em svg, e como o elemento tem proporção intrínseca vinda do
   * viewBox, o auto resolvia para largura ÷ proporção em vez de esticar — que
   * era a razão de o círculo cobrir só a parte de cima do cartão.
   */
  .circle-mark {
    position: absolute;
    /* Deslocado à direita de propósito: o início e a cauda do traço ficam do
       lado esquerdo, então o desenho tem mais massa ali e o centro óptico não
       coincide com o centro geométrico. A caixa mantém o tamanho — só o ponto
       de partida horizontal muda, o que translada o círculo inteiro. */
    inset-block: -1.5rem;
    inset-inline-start: -0.3rem;
    width: calc(100% + 3rem);
    height: calc(100% + 3rem);
    overflow: visible;
    pointer-events: none;
    color: var(--color-accent);
    /*
     * Sem isto o traço fica POR BAIXO do cartão seguinte. Ele transborda a
     * própria caixa, e irmãos posteriores pintam por cima de irmãos anteriores
     * quando todos têm z-index automático. Um z-index positivo tira o desenho
     * dessa fila e o coloca numa camada acima de todos eles.
     */
    z-index: 1;
    opacity: 0;
    transition: opacity 160ms ease-out;
  }

  /*
   * SEM `vector-effect: non-scaling-stroke`, e isso é decisão, não esquecimento.
   *
   * Ele faz o navegador medir o tracejado no espaço da tela, o que anula o
   * `pathLength="100"` — o dasharray virava 100px num caminho de várias
   * centenas, e sobrava traço visível o tempo todo. As duas propriedades são
   * incompatíveis.
   *
   * Tirá-lo tem um efeito colateral desejado: com `preserveAspectRatio="none"`
   * o viewBox estica para acompanhar o cartão, e a espessura passa a variar
   * entre os trechos horizontais e verticais. É de onde vem a irregularidade de
   * pincel, em vez de um traço de compasso.
   */
  .circle-mark path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-opacity: 0.72;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    transition: stroke-dashoffset 460ms ease-out;
  }

  /* A segunda passada sai depois e mais fina, como quem reforça o círculo. */
  .cards--scattered > li:hover .circle-mark,
  .cards--scattered > li:focus-within .circle-mark {
    opacity: 1;
  }

  /*
   * Onde não há cursor, o círculo é dirigido pela classe `is-centered`, posta
   * por JS no cartão mais central da tela.
   *
   * Poderia ser CSS puro com timeline por scroll, e era assim antes — mas o
   * traço transborda o cartão e `.card` tem `transform`, que cria contexto de
   * empilhamento e prende o SVG lá dentro. Nenhum z-index interno escapa disso;
   * quem precisa subir é o <li>. E subir o <li> exige saber qual está ativo,
   * o que só a classe dá. Um caminho só, em vez de dois divergindo.
   */
  .cards--scattered > li.is-centered {
    z-index: 3;
  }

  .cards--scattered > li.is-centered .circle-mark {
    opacity: 1;
  }

  .cards--scattered > li.is-centered .circle-mark path {
    stroke-dashoffset: 0;
  }

  .cards--scattered > li:hover .circle-mark path,
  .cards--scattered > li:focus-within .circle-mark path {
    stroke-dashoffset: 0;
  }

  /* Nos projetos o cartão só volta ao prumo; quem cresce seria concorrência
     visual com o traço sendo desenhado em volta. */
  .cards--scattered > li:hover .card--project,
  .cards--scattered > li:focus-within .card--project {
    transform: translate(0, 0) rotate(0deg);
  }

  /* O cartão ativo sobe acima dos vizinhos — senão o cartão seguinte corta o
