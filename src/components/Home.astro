---
import Base from '../layouts/Base.astro';
import { education } from '../lib/content/education.ts';
import { impact } from '../lib/content/impact.ts';
import { openSource } from '../lib/content/open-source.ts';
import { profile } from '../lib/content/profile.ts';
import { projects } from '../lib/content/projects.ts';
import { timeline } from '../lib/content/timeline.ts';
import { sectionSurfaces } from '../lib/design/section-surfaces.ts';
import { formatPeriod } from '../lib/i18n/format-period.ts';
import { localePath } from '../lib/i18n/locale-path.ts';
import type { Locale } from '../lib/i18n/locales.ts';
import { ui } from '../lib/i18n/ui.ts';
import { profilePage } from '../lib/seo/profile-page.ts';
import BackToTop from './BackToTop.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Link from './Link.astro';
import RichText from './RichText.astro';
import Section from './Section.astro';
import Terrarium from './Terrarium.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { pathname } = Astro.url;

const site = Astro.site?.href ?? 'https://henriqueartur.com';
const url = new URL(localePath(pathname, locale), site).href;

const featured = openSource.find((repo) => repo.featured);
const others = openSource.filter((repo) => !repo.featured);
---

<Base
  title={`${profile.name} — ${profile.role[locale]}`}
  description={profile.tagline[locale]}
  locale={locale}
  schema={[profilePage({ site, locale, url })]}
>
  <header id="top" class="hero surface surface--grid">
    <div class="shell">
      <div class="hero__top">
        <p class="label hero__eyebrow">
          {profile.role[locale]} · {profile.location[locale]}
        </p>
        <div class="hero__nav">
          <p class="label hero__blog">
            <a href={locale === 'en' ? '/en/blog/' : '/blog/'}>{ui.blogLabel[locale]}</a>
          </p>
          <LanguageSwitcher locale={locale} pathname={pathname} />
        </div>
      </div>

      <div class="hero__body">
        <div class="hero__text">
          <h1 class="hero__name">{profile.name}</h1>
          <p class="label hero__signature">{profile.signature}</p>
          <p class="hero__tagline">{profile.tagline[locale]}</p>

          <nav aria-label={ui.contactLinks[locale]}>
            <ul class="hero__links">
              {
                profile.links.map((link) => (
                  <li>
                    <Link href={link.href} locale={locale}>{link.label}</Link>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>

        <div class="hero__aside">
          <Terrarium />
          {/*
            Espaçador que dá alcance ao sticky.
            `padding` NÃO serve aqui: um elemento grudado se move dentro da
            content box do pai, e padding fica fora dela. Só conteúdo de verdade
            estende esse limite.
          */}
          <div class="hero__reach" aria-hidden="true"></div>
        </div>
      </div>
    </div>
  </header>

  <main id="conteudo">
      <Section
        id="sobre"
        surface={sectionSurfaces['sobre']}
        number="01"
        label={ui.aboutLabel[locale]}
        title={ui.aboutTitle[locale]}
      >
        <div class="prose">
          {
            profile.summary.map((paragraph) => (
              <p>
                <RichText text={paragraph[locale]} />
              </p>
            ))
          }
        </div>
      </Section>

      <Section
        id="impacto"
        surface={sectionSurfaces['impacto']}
        note={ui.noteImpact[locale]}
        number="02"
        label={ui.impactLabel[locale]}
        title={ui.impactTitle[locale]}
      >
        <ul class="cards cards--scattered">
          {
            impact.map((item) => (
              <li class="card-enter">
                {/*
                  O cartão é um elemento interno de propósito: a revelação por
                  scroll anima o transform do <li>, e o hover transiciona o
                  transform do <article>. Na mesma caixa os dois disputariam a
                  mesma propriedade, e passar o mouse durante a entrada cortaria
                  a entrada pela metade.
                */}
                <article class="card card--impact">
                  {item.metric && <p class="card__metric">{item.metric[locale]}</p>}
                  <h3 class="card__title">{item.title[locale]}</h3>
                  <p class="card__text">{item.description[locale]}</p>
                </article>
              </li>
            ))
          }
        </ul>
      </Section>

      <Section
        id="projetos"
        surface={sectionSurfaces['projetos']}
        note={ui.noteProjects[locale]}
        number="03"
        label={ui.projectsLabel[locale]}
        title={ui.projectsTitle[locale]}
      >
        <ul class="cards cards--scattered">
          {
            projects.map((project) => (
              <li class="reveal">
                <article class="card card--project">
                  {/*
                    Círculo de marcador, desenhado no hover. `pathLength="100"`
                    normaliza o comprimento do traço: sem isso o dasharray teria
                    que casar com a geometria exata do caminho, e qualquer ajuste
                    no desenho quebraria a animação sem erro nenhum.

                    A curva da esquerda usa x negativo de propósito: ela sai do
                    viewBox para abrir mais raio daquele lado. Só funciona porque
                    o CSS declara `overflow: visible` — com o padrão `hidden` do
                    SVG, esse trecho seria cortado.
                  */}
                  <svg
                    class="circle-mark"
                    viewBox="0 0 200 140"
                    preserveAspectRatio="none"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path
                      pathLength="100"
                      d="M14 21 C56 4, 144 3, 181 21 C199 46, 198 112, 177 130 C127 145, 46 144, 12 124 C-9 98, -8 39, 4 18 C14 9, 40 4, 68 3"
                    />
                  </svg>

                  <h3 class="card__title">{project.name[locale]}</h3>
                  <p class="label card__context">{project.context}</p>
                  <p class="card__text">{project.description[locale]}</p>
                  <ul class="tags">
                    {project.tech.map((tech) => (
                      <li class="tag">{tech}</li>
                    ))}
                  </ul>
                </article>
              </li>
            ))
          }
        </ul>
      </Section>

      <Section
        id="open-source"
        surface={sectionSurfaces['open-source']}
        number="04"
        label={ui.openSourceLabel[locale]}
        title={ui.openSourceTitle[locale]}
      >
        {
          featured && (
            <article class="featured reveal">
              <h3 class="featured__name">
                <Link href={featured.href} locale={locale}>{featured.name}</Link>
              </h3>
              <p class="label">{featured.language}</p>
              <p class="featured__text">{featured.description[locale]}</p>
            </article>
          )
        }

        <ul class="cards tilt-list">
          {
            others.map((repo) => (
              <li class="card reveal">
                <h3 class="card__title">
                  <Link href={repo.href} locale={locale}>{repo.name}</Link>
                </h3>
                <p class="label card__context">{repo.language}</p>
                <p class="card__text">{repo.description[locale]}</p>
              </li>
            ))
          }
        </ul>
      </Section>

      <Section
        id="trajetoria"
        surface={sectionSurfaces['trajetoria']}
        note={ui.noteTimeline[locale]}
        number="05"
        label={ui.timelineLabel[locale]}
        title={ui.timelineTitle[locale]}
      >
        <ol class="timeline">
          {
            timeline.map((entry) => (
              <li
                class="timeline__entry reveal"
                data-current={entry.end === null ? 'true' : undefined}
              >
                {/*
                  Marcador como elemento, e não ::before: o driver precisa medir
                  a posição exata do centro dele para sincronizar com a linha, e
                  pseudo-elemento não é mensurável por JS.
                */}
                <span class="timeline__dot" aria-hidden="true"></span>
                <p class="label timeline__period">{formatPeriod(entry.start, entry.end, locale)}</p>
                <h3 class="timeline__company">{entry.company}</h3>
                <ul class="timeline__roles">
                  {entry.roles.map((role) => (
                    <li>
                      <span class="timeline__role">{role.title[locale]}</span>
                      <span class="timeline__role-period">
                        {formatPeriod(role.start, role.end, locale)}
                      </span>
                    </li>
                  ))}
                </ul>
                {entry.note && <p class="timeline__note">{entry.note[locale]}</p>}
              </li>
            ))
          }
        </ol>
      </Section>

      <Section
        id="formacao"
        surface={sectionSurfaces['formacao']}
        number="06"
        label={ui.educationLabel[locale]}
        title={ui.educationTitle[locale]}
      >
        <ol class="records">
          {
            education.map((degree) => (
              <li class="records__entry reveal">
                <p class="label timeline__period">
                  {formatPeriod(degree.start, degree.end, locale)}
                </p>
                <h3 class="timeline__company">{degree.title[locale]}</h3>
                <p class="timeline__role">{degree.institution}</p>
                {degree.note && <p class="timeline__note">{degree.note[locale]}</p>}
              </li>
            ))
          }
        </ol>
      </Section>

      <Section
        id="contato"
        surface={sectionSurfaces['contato']}
        number="07"
        label={ui.contactLabel[locale]}
        title={ui.contactTitle[locale]}
      >
        <div class="prose">
          <p>{ui.contactLead[locale]}</p>
        </div>
        <ul class="hero__links contact__links">
          {
            profile.links.map((link) => (
              <li>
                <Link href={link.href} locale={locale}>{link.label}</Link>
              </li>
            ))
          }
        </ul>
      </Section>
  </main>

  <footer class="footer surface surface--plain">
    <div class="shell">
      <p class="label footer__signature">
        © {profile.name}
        <span class="footer__mark" aria-hidden="true">·</span>
        {profile.signature}
      </p>
      {/* Atribuição exigida pela CC BY 4.0 do modelo 3D. */}
      <p class="label footer__credit">
        3D: <Link href="https://sketchfab.com/3d-models/smol-ame-in-an-upcycled-terrarium-hololiveen-490cecc249d242188fda5ad3160a4b24" locale={locale}>Smol Ame in an upcycled terrarium</Link>
        {' '}by Seafoam,{' '}
        <Link href="https://creativecommons.org/licenses/by/4.0/" locale={locale}>CC BY 4.0</Link>
      </p>
    </div>
  </footer>

  <BackToTop locale={locale} />
</Base>

<script>
  import { markerOffsets, reachedMarkers, trackProgress } from '../scripts/motion/track-state.ts';

  /*
   * Linha do tempo: o traço cresce com a rolagem e cada marcador acende quando
   * a linha chega nele.
   *
   * Os dois saem do MESMO número. Seriam duas animações independentes se cada
   * marcador tivesse o próprio gatilho, e nesse caso qualquer ajuste de
   * espaçamento os faria discordar sobre quando a linha "chegou". Aqui a linha
   * é `--track-progress` e o marcador acende quando o progresso passa da
   * posição dele — não há como dessincronizar.
   */
  const track = document.querySelector<HTMLElement>('#trajetoria .timeline');
  const stops = track ? [...track.querySelectorAll<HTMLElement>('.timeline__entry')] : [];

  if (track && stops.length > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    track.classList.add('is-tracking');

    let offsets: number[] = [];
    let first = 0;
    let span = 0;
    let scheduled = false;

    const measure = () => {
      // offsetTop do marcador é relativo ao <li>; somar o do <li> dá a posição
      // dentro da lista, que é o sistema de coordenadas da linha.
      const centers = stops.map((stop) => {
        const dot = stop.querySelector<HTMLElement>('.timeline__dot');
        return dot ? stop.offsetTop + dot.offsetTop + dot.offsetHeight / 2 : stop.offsetTop;
      });

      offsets = markerOffsets(centers);
      first = centers[0] ?? 0;
      span = (centers.at(-1) ?? 0) - first;

      // A linha desenhada vai de centro a centro de marcador, e não de borda a
      // borda da lista — é o que faz progresso 0 e 1 caírem exatamente sobre o
      // primeiro e o último.
      track.style.setProperty('--track-top', `${first}px`);
      track.style.setProperty('--track-height', `${span}px`);
    };

    const update = () => {
      scheduled = false;

      const progress = trackProgress(
        { top: track.getBoundingClientRect().top + first, height: span },
        window.innerHeight,
      );

      track.style.setProperty('--track-progress', progress.toFixed(4));

      reachedMarkers(progress, offsets).forEach((reached, index) => {
        stops[index]?.classList.toggle('is-reached', reached);
      });
    };

    const schedule = () => {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(update);
    };

    measure();
    update();
    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', () => {
      measure();
      schedule();
    }, { passive: true });
  }
</script>

<script>
  import { driftProgress } from '../scripts/motion/drift-progress.ts';
  import { stickyRange } from '../scripts/motion/sticky-range.ts';

  /*
   * Alcance do objeto grudado: ele acompanha até o "Sobre" começar a sair.
   *
   * `position: sticky` só se move dentro do bloco que contém o elemento, então
   * o alcance precisa ser criado com padding. Medir em vez de cravar um valor
   * porque a altura do "Sobre" depende do texto, que muda entre os idiomas.
   */
  const aside = document.querySelector<HTMLElement>('.hero__aside');
  const about = document.querySelector<HTMLElement>('#sobre');

  if (aside && about) {
    const measure = () => {
      // Sem o alcance atual na conta, a medição da vez anterior contaminaria a
      // próxima e o valor cresceria a cada resize.
      aside.style.removeProperty('--sticky-range');

      const scroll = window.scrollY;
      const box = aside.getBoundingClientRect();

      // A altura contada é a do objeto, não a do aside: o aside já inclui o
      // espaçador, e usá-lo realimentaria a conta a cada medição.
      const object = aside.firstElementChild?.getBoundingClientRect();

      /*
       * Até onde o objeto acompanha, e isso muda com a largura.
       *
       * No desktop ele para no fim do "Sobre": mais que isso e ele passaria a
       * disputar espaço com as seções de cartões, que já têm movimento próprio.
       *
       * No mobile ele encolhe para o canto e vira um elemento discreto — ali
       * acompanhar a página inteira não atrapalha nada, e some antes da hora
       * é que pareceria abandono.
       */
      const sideBySide = matchMedia('(min-width: 48rem)').matches;

      const sectionBottom = sideBySide
        ? about.getBoundingClientRect().bottom + scroll
        : document.documentElement.scrollHeight;

      const range = stickyRange({
        boxTop: box.top + scroll,
        boxHeight: object?.height ?? box.height,
        sectionBottom,
        // Folga em fração da janela, e não em pixels: numa tela alta o objeto
        // precisa percorrer mais para dar a mesma sensação de demorar a soltar.
        // No mobile o alvo já é o fim da página, então não há o que acrescentar.
        extra: sideBySide ? window.innerHeight * 0.4 : 0,
      });

      aside.style.setProperty('--sticky-range', `${Math.round(range)}px`);
    };

    /*
     * `--drift` mede quanto tempo o objeto passa PARADO, de 0 a 1.
     *
     * O que se faz com esse número é decisão do CSS, e é diferente em cada
     * largura: no desktop ele desliza para a direita, liberando a coluna de
     * leitura; no mobile ele encolhe para o canto superior direito, porque ali
     * ocupa a largura toda e sair de lado só o cortaria.
     */
    const stuckAt = 5 * 16;

    let scheduled = false;

    const drift = () => {
      scheduled = false;

      const progress = driftProgress({
        boxTop: aside.getBoundingClientRect().top,
        stickyTop: stuckAt,
        // Rampa em fração da janela: numa tela alta o deslocamento precisa de
        // mais rolagem para não parecer um salto.
        ramp: window.innerHeight * 0.32,
      });

      aside.style.setProperty('--drift', progress.toFixed(4));
    };

    const schedule = () => {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(drift);
    };

    measure();
    drift();
    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', () => {
      measure();
      schedule();
    }, { passive: true });
  }
</script>

<script>
  import { pileProgress, pileState } from '../scripts/motion/pile-state.ts';

  /*
   * Dirige a pilha dos cartões de impacto.
   *
   * A pilha inteira desce um slot por vez e deixa o cartão do topo para trás:
   *
   *   [123456] _ _ _ _ _   →   1 [23456] _ _ _ _   →   1 2 [3456] _ _ _
   *
   * Roda a cada quadro em vez de ser CSS porque cada cartão percorre um número
   * diferente de slots sobre uma mesma linha do tempo — o cartão 6 passa por
   * cinco, o cartão 2 por um. Em CSS isso seria um @keyframes por cartão.
   *
   * Só no mobile: no desktop são duas colunas e a pilha não faz sentido.
   */
  const list = document.querySelector<HTMLElement>('#impacto .cards--scattered');
  const cards = list ? [...list.querySelectorAll<HTMLElement>('.card-enter')] : [];

  if (list && cards.length > 0) {
    const singleColumn = matchMedia('(max-width: 47.99rem)');
    const stillMotion = matchMedia('(prefers-reduced-motion: reduce)');

    // `offsetTop` não muda com a rolagem e transform não altera layout, então a
    // medida vale mesmo com os cartões já deslocados.
    let slots = cards.map((card) => card.offsetTop);
    let scheduled = false;

    // Ordem de pintura da pilha: o primeiro cartão por cima, e fixa. Ela não
    // muda durante o movimento, então é atribuída uma vez e com inteiro.
    cards.forEach((card, index) => {
      card.style.zIndex = String(cards.length - index);
    });

    const release = () => {
      list.classList.remove('js-pile');
      for (const card of cards) {
        card.style.removeProperty('--stack-offset');
        card.style.removeProperty('--stack-depth');
      }
    };

    const apply = () => {
      scheduled = false;

      if (!singleColumn.matches || stillMotion.matches) {
        release();
        return;
      }

      list.classList.add('js-pile');

      const progress = pileProgress(list.getBoundingClientRect(), window.innerHeight);

      pileState(progress, slots).forEach((state, index) => {
        const card = cards[index];
        if (!card) return;
        card.style.setProperty('--stack-offset', `${state.offset}px`);
        card.style.setProperty('--stack-depth', state.depth.toFixed(3));
      });
    };

    const schedule = () => {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(apply);
    };

    const remeasure = () => {
      // Solta a pilha antes de medir: com os cartões deslocados a leitura ainda
      // seria correta, mas soltar também cobre a virada para o desktop.
      release();
      slots = cards.map((card) => card.offsetTop);
      schedule();
    };

    apply();
    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', remeasure, { passive: true });
  }
</script>

<style>
  .shell {
    max-width: var(--layout-max-width);
    padding-inline: var(--space-2);
    margin-inline: auto;
  }

  /* Cartão sobre superfície texturizada precisa de fundo próprio para o texto
     não disputar leitura com a trama por baixo. */
  .card,
  .featured {
    box-shadow: 2px 2px 0 color-mix(in srgb, var(--color-ink) 10%, transparent);
  }

  /* ---------- hero ---------- */

  .hero {
    padding-block: var(--space-4) var(--space-6);
  }

  /*
   * No mobile, coluna com a navegação em cima.
   *
   * Em linha, o cargo — "Tech Lead · Fortaleza, Ceará — Brasil" — consome a
   * largura toda e empurra a navegação para uma segunda linha, onde ela fica
   * órfã à esquerda. Empilhado e com a navegação primeiro, ela ocupa o lugar
   * que já é o dela em qualquer site: o topo.
   */
  .hero__top {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    margin-block-end: var(--space-3);
  }

  .hero__nav {
    order: -1;
    /* Encostada na direita: é onde navegação mora, e a coluna à esquerda fica
       livre para o cargo e o nome começarem no mesmo eixo. */
    align-self: flex-end;
  }

  .hero__eyebrow {
    margin: 0;
  }

  /*
   * O alcance é medido em JS: vai até o fim do "Sobre", cuja altura depende do
   * texto — e o texto muda de tamanho entre português e inglês. O padrão só
   * vale até a medição acontecer.
   */
  .hero__reach {
    block-size: var(--sticky-range, 20rem);
  }

  /*
   * A margem negativa cancela o espaçador e precisa valer em QUALQUER largura.
   *
   * Ela estava só no desktop, e no mobile o espaçador ficava sem contrapeso —
   * eram ~20rem de vazio entre o hero e o "Sobre". O espaçador existe para dar
   * alcance ao sticky, não para ocupar espaço.
   */
  .hero__aside {
    margin-block-end: calc(-1 * var(--sticky-range, 20rem));
  }

  /*
   * O texto fica acima do objeto 3D.
   *
   * O objeto precisa de z-index positivo para invadir a seção seguinte — sem
   * ele, o fundo da próxima seção pinta por cima. Mas isso também o colocava
   * acima do texto do hero. A saída é o texto ter um degrau a mais: texto (2),
   * objeto (1), fundos das seções (automático).
   */
  .hero__text {
    position: relative;
    z-index: 2;
    /* Base de 20rem para a coluna não ser espremida pelo objeto ao lado. */
    flex: 1 1 20rem;
    min-width: 0;
  }

  .hero__nav {
    display: flex;
    gap: var(--space-2);
    align-items: center;
  }

  /* Mesma altura das fichas de idioma, para a linha de navegação ficar reta. */
  .hero__blog {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    margin: 0;
  }

  .hero__name {
    font-size: var(--font-size-hero);
    /* Entrelinha apertada e letras próximas: num nome grande, o espaçamento
       padrão de leitura o faz parecer solto em vez de sólido. */
    line-height: 1.02;
    letter-spacing: -0.03em;
    margin-block-end: var(--space-2);
  }

  /*
   * A assinatura é etiqueta, não linha de prosa: monoespaçada, em caixa alta,
   * com um traço de cota antes. É o que a impede de virar mais uma frase entre
   * o nome e a tagline.
   */
  .hero__signature {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin-block-end: var(--space-2);
    color: var(--color-accent-deep);
  }

  .hero__signature::before {
    content: '';
    flex: 0 0 var(--space-3);
    height: 1px;
    background-color: var(--color-accent-deep);
  }

  .footer__signature {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-1);
  }

  .footer__mark {
    color: var(--color-line-strong);
  }

  .hero__tagline {
    max-width: 26ch;
    font-size: clamp(1.125rem, 1.6vw, 1.5rem);
    line-height: 1.35;
    color: var(--color-ink-soft);
    margin-block-end: var(--space-3);
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    padding: 0;
    list-style: none;
  }

  /* ---------- cartões ---------- */

  .cards {
    display: grid;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .card {
    padding: var(--space-2);
    background-color: var(--color-paper-deep);
    border: 1px solid var(--color-line-strong);
  }

  .card__metric {
    font-family: var(--font-display);
    font-size: var(--font-size-2xl);
    font-weight: 700;
    line-height: var(--line-height-tight);
    color: var(--color-accent-deep);
  }

  .card__title {
    font-size: var(--font-size-lg);
    margin-block-end: var(--space-1);
  }

  .card__context {
    margin-block-end: var(--space-1);
  }

  .card__text {
    font-size: var(--font-size-sm);
  }

  /* ---------- impacto: cartões jogados na mesa ---------- */

  .cards--scattered > li {
    position: relative;
  }

  /*
   * A ordem da pilha é definida em JS, não aqui.
   *
   * A tentação era `z-index: calc(100 - var(--stack-depth))`, mas --stack-depth
   * é fracionário e z-index só aceita inteiro. Valor inválido faz o navegador
   * descartar a declaração, o z-index volta a `auto`, e a pintura cai na ordem
   * do DOM — a pilha aparece por cima do cartão que já assentou, e o defeito
   * pisca conforme o número passa por valores inteiros.
   */

  /*
   * "Jogado" vem principalmente do deslocamento, não da rotação. Inclinar muito
   * um bloco com três linhas de texto cansa a leitura; deslocar não. Por isso a
   * rotação fica em torno de 1,5° e o resto do efeito vem do offset.
   */
  .cards--scattered .card {
    transform: translate(var(--shift-x, 0), var(--shift-y, 0)) rotate(var(--tilt, 0deg));
    /* O cubic-bezier passa de 1 no terceiro parâmetro: a curva ultrapassa o
       destino e volta. É de onde vem a sensação de "mexeu" — sem keyframes, e
       reversível, então sair com o mouse desfaz pelo mesmo caminho. */
    transition:
      transform 300ms cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 300ms ease;
  }

  /* Sob o cursor o cartão vai para o prumo e cresce: sai da pilha bagunçada e
     se apresenta. */
  .cards--scattered > li:hover .card,
  .cards--scattered > li:focus-within .card {
    transform: translate(0, 0) rotate(0deg) scale(1.04);
    box-shadow: 5px 6px 0 color-mix(in srgb, var(--color-ink) 16%, transparent);
  }

  /*
   * Mobile primeiro, e aqui isso muda o desenho, não só a medida.
   *
   * Em coluna única o cartão ocupa a largura toda, então o mesmo ângulo desloca
   * muito mais os cantos — o que era "jogado na mesa" vira "torto". E qualquer
   * deslocamento horizontal empurraria o cartão contra a margem do container.
   *
   * Por isso aqui a rotação é quase imperceptível e o shift-x é zero. O
   * espalhamento de verdade começa a partir de 48rem, onde há duas colunas e
   * sobra folga lateral.
   */
  .cards--scattered > li:nth-child(2n + 1) .card {
    --tilt: -0.4deg;
    --shift-y: 0.1rem;
  }

  .cards--scattered > li:nth-child(2n + 2) .card {
    --tilt: 0.35deg;
    --shift-y: -0.1rem;
  }

  /* Texto menor: o cartão de impacto é leitura de relance, não de fôlego. */
  .card--impact .card__metric {
    font-size: var(--font-size-xl);
  }

  .card--impact .card__title {
    font-size: var(--font-size-base);
  }

  .card--impact .card__text {
    font-size: var(--font-size-xs);
    line-height: 1.55;
  }

  /* ---------- impacto: desempilhar ao rolar (só no mobile) ---------- */

  /*
   * No mobile os cartões entram como se estivessem empilhados: cada um chega
   * de trás e de cima, menor e mais torto, e assenta no lugar conforme rola.
   *
   * Isto substitui o `.reveal` genérico em vez de somar a ele — duas regras
   * `animation` no mesmo elemento não se combinam, a última simplesmente vence.
   * Por isso o <li> usa `card-enter`, e o que muda no breakpoint é só o
   * `animation-name`.
   */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      /* Longhand obrigatório — ver o aviso em global.css. */
      .card-enter {
        animation-name: settle;
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 5% entry 80%;
      }

    }
  }

  /*
   * Pilha dirigida por JS. `animation: none` desliga a versão em CSS, que não
   * consegue expressar este movimento: a pilha desce um slot por vez e cada
   * cartão passa por vários slots, o que exigiria keyframes diferentes por
   * cartão sobre uma linha do tempo compartilhada.
   */
  .js-pile .card-enter {
    animation: none;
    opacity: 1;
    transform: translateY(var(--stack-offset, 0px))
      translateX(calc(var(--stack-depth, 0) * 4px))
      scale(calc(1 - var(--stack-depth, 0) * 0.02))
      rotate(calc(var(--stack-depth, 0) * -1.1deg));
  }

  @keyframes settle {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ---------- projetos: círculo de marcador ---------- */

  .card--project {
    position: relative;
  }

  /*
   * O traço fica FORA do cartão, com inset negativo: marcador de quadro circula
   * em volta do que destaca, não por dentro.
   *
   * Largura e altura são explícitas, e não `auto`. O reset global aplica
   * `height: auto` em svg, e como o elemento tem proporção intrínseca vinda do
   * viewBox, o auto resolvia para largura ÷ proporção em vez de esticar — que
   * era a razão de o círculo cobrir só a parte de cima do cartão.
   */
  .circle-mark {
    position: absolute;
    /* Deslocado à direita de propósito: o início e a cauda do traço ficam do
       lado esquerdo, então o desenho tem mais massa ali e o centro óptico não
       coincide com o centro geométrico. A caixa mantém o tamanho — só o ponto
       de partida horizontal muda, o que translada o círculo inteiro. */
    inset-block: -1.5rem;
    inset-inline-start: -0.3rem;
    width: calc(100% + 3rem);
    height: calc(100% + 3rem);
    overflow: visible;
    pointer-events: none;
    color: var(--color-accent);
    /*
     * Sem isto o traço fica POR BAIXO do cartão seguinte. Ele transborda a
     * própria caixa, e irmãos posteriores pintam por cima de irmãos anteriores
     * quando todos têm z-index automático. Um z-index positivo tira o desenho
     * dessa fila e o coloca numa camada acima de todos eles.
     */
    z-index: 1;
    opacity: 0;
    transition: opacity 160ms ease-out;
  }

  /*
   * SEM `vector-effect: non-scaling-stroke`, e isso é decisão, não esquecimento.
   *
   * Ele faz o navegador medir o tracejado no espaço da tela, o que anula o
   * `pathLength="100"` — o dasharray virava 100px num caminho de várias
   * centenas, e sobrava traço visível o tempo todo. As duas propriedades são
   * incompatíveis.
   *
   * Tirá-lo tem um efeito colateral desejado: com `preserveAspectRatio="none"`
   * o viewBox estica para acompanhar o cartão, e a espessura passa a variar
   * entre os trechos horizontais e verticais. É de onde vem a irregularidade de
   * pincel, em vez de um traço de compasso.
   */
  .circle-mark path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-opacity: 0.72;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    transition: stroke-dashoffset 460ms ease-out;
  }

  /* A segunda passada sai depois e mais fina, como quem reforça o círculo. */
  .cards--scattered > li:hover .circle-mark,
  .cards--scattered > li:focus-within .circle-mark {
    opacity: 1;
  }

  /*
   * Onde não há cursor, o círculo é dirigido pela classe `is-centered`, posta
   * por JS no cartão mais central da tela.
   *
   * Poderia ser CSS puro com timeline por scroll, e era assim antes — mas o
   * traço transborda o cartão e `.card` tem `transform`, que cria contexto de
   * empilhamento e prende o SVG lá dentro. Nenhum z-index interno escapa disso;
   * quem precisa subir é o <li>. E subir o <li> exige saber qual está ativo,
   * o que só a classe dá. Um caminho só, em vez de dois divergindo.
   */
  .cards--scattered > li.is-centered {
    z-index: 3;
  }

  .cards--scattered > li.is-centered .circle-mark {
    opacity: 1;
  }

  .cards--scattered > li.is-centered .circle-mark path {
    stroke-dashoffset: 0;
  }

  .cards--scattered > li:hover .circle-mark path,
  .cards--scattered > li:focus-within .circle-mark path {
    stroke-dashoffset: 0;
  }

  /* Nos projetos o cartão só volta ao prumo; quem cresce seria concorrência
     visual com o traço sendo desenhado em volta. */
  .cards--scattered > li:hover .card--project,
  .cards--scattered > li:focus-within .card--project {
    transform: translate(0, 0) rotate(0deg);
  }

  /* O cartão ativo sobe acima dos vizinhos — senão o cartão seguinte corta o
     balanço do de impacto e o círculo do de projeto. */
  .cards--scattered > li:hover,
  .cards--scattered > li:focus-within {
    z-index: 3;
  }


  /*
   * Cartão sobre a superfície invertida.
   *
   * Sem isto o cartão mantém o fundo `paperDeep` e herda o texto `paper` da
   * seção — claro sobre claro, 1.13:1. Não era "pouco contraste": era
   * invisível.
   */
  :global(.surface--inverted) .card {
    color: var(--color-paper);
    background-color: var(--color-ink-lift);
    border-color: var(--color-line);
    box-shadow: 2px 2px 0 color-mix(in srgb, var(--color-paper) 12%, transparent);
  }

  /*
   * `:global(a)` porque o <a> vem do componente Link e não carrega o escopo
   * deste arquivo — um seletor escopado simplesmente não o alcança.
   */
  :global(.surface--inverted) .card :global(a) {
    color: var(--color-paper);
  }

  /* ---------- destaque de open source ---------- */

  /*
   * O destaque inverte de novo: cartão de papel sobre a seção de tinta.
   *
   * Antes ele tinha fundo `ink` — que era o fundo da seção também, então o
   * destaque desaparecia dentro dela. Trocar a direção da inversão é o que o
   * faz voltar a destacar.
   */
  .featured {
    padding: var(--space-3);
    color: var(--color-ink);
    background-color: var(--color-paper);
    border: 2px solid var(--color-accent);
    margin-block-end: var(--space-2);
  }

  .featured :global(.label) {
    color: var(--color-ink-soft);
  }

  .featured__name {
    font-size: var(--font-size-xl);
  }

  /*
   * Idem, e aqui era crítico: sem esta regra sobrava a global
   * `.surface--inverted a { color: paper }`, e o destaque agora tem fundo de
   * papel — texto de papel sobre papel, invisível.
   */
  .featured__name :global(a) {
    color: var(--color-accent-deep);
  }

  /*
   * O destaque é uma ilha CLARA dentro da seção invertida, e as regras de link
   * daquela seção assumem fundo escuro: o marcador vem no laranja claro e o
   * texto fica em `paper` no hover — papel sobre papel de novo.
   *
   * Aqui o link volta a se comportar como sobre papel, que é o que ele é.
   */
  .featured :global(a) {
    --marker: var(--color-accent);
  }

  .featured :global(a:hover) {
    color: var(--color-ink);
  }

  .featured__text {
    margin-block-start: var(--space-1);
  }

  /* ---------- etiquetas ---------- */

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    padding: 0;
    margin-block-start: var(--space-1);
    list-style: none;
  }

  .tag {
    padding: 0.125rem 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-ink);
    background-color: var(--color-paper);
    border: 1px solid var(--color-line-strong);
  }

  .tag--muted {
    color: var(--color-ink-soft);
    background-color: transparent;
  }

  /* ---------- trajetória ---------- */

  /*
   * Linha de rastreamento: um traço contínuo com um marcador por parada.
   *
   * Os marcadores são quadrados, não círculos. Rastreamento de entrega usa
   * bolinha, mas o design system deste site não tem nada arredondado — e
   * quadrado sobre linha é justamente o vocabulário de ponto de cota em desenho
   * técnico, que é o conceito da página.
   */
  .timeline {
    position: relative;
    padding: 0;
    padding-inline-start: var(--space-3);
    list-style: none;
  }

  /*
   * Duas linhas sobrepostas: a base, fraca, mostra o percurso inteiro; a de
   * cima, forte, cresce conforme você rola.
   *
   * `--track-top` e `--track-height` são escritos pelo driver e vão do centro
   * do primeiro marcador ao centro do último — não das bordas da lista. É o que
   * faz progresso 0 significar exatamente "no primeiro marcador" e 1 "no
   * último", sem sobra em nenhuma ponta.
   *
   * O padrão de `--track-progress` é 1: sem JavaScript a linha aparece inteira,
   * sólida, como estava antes.
   */
  .timeline::before,
  .timeline::after {
    content: '';
    position: absolute;
    inset-block-start: var(--track-top, 0.75rem);
    inset-inline-start: 0.3125rem;
    width: 1px;
    height: var(--track-height, calc(100% - 1.5rem));
  }

  .timeline::before {
    background-color: var(--color-line);
  }

  .timeline::after {
    background-color: var(--color-line-strong);
    transform-origin: top;
    transform: scaleY(var(--track-progress, 1));
  }

  .timeline__entry {
    position: relative;
    padding-block-end: var(--space-3);
  }

  .timeline__entry:last-child {
    padding-block-end: 0;
  }

  /* Estado de repouso = estado final. O driver é que introduz o estado inicial
     apagado, sob `.is-tracking` — sem JS ou com movimento reduzido, tudo já
     está no lugar certo. */
  .timeline__dot {
    position: absolute;
    inset-block-start: 0.45rem;
    inset-inline-start: calc(-1 * var(--space-3));
    width: 0.625rem;
    height: 0.625rem;
    background-color: var(--color-paper);
    border: 2px solid var(--color-line-strong);
  }

  .timeline__entry[data-current] .timeline__dot {
    background-color: var(--color-accent);
    border-color: var(--color-accent-deep);
  }

  /* Linha de cota, do marcador até o conteúdo. */
  .timeline__entry::after {
    content: '';
    position: absolute;
    inset-block-start: 0.72rem;
    inset-inline-start: calc(-1 * var(--space-3) + 0.625rem);
    width: calc(var(--space-3) - 0.625rem);
    height: 1px;
    background-color: var(--color-line-strong);
    transform-origin: 0 50%;
  }

  /* ---------- estados animados, só sob o driver ---------- */

  .timeline.is-tracking .timeline__dot {
    border-color: var(--color-line);
    transform: scale(0.6);
    transition:
      border-color 260ms ease-out,
      transform 260ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .timeline.is-tracking .timeline__entry.is-reached .timeline__dot {
    border-color: var(--color-line-strong);
    transform: scale(1);
  }

  .timeline.is-tracking .timeline__entry::after {
    transform: scaleX(0);
    transition: transform 320ms ease-out 140ms;
  }

  .timeline.is-tracking .timeline__entry.is-reached::after {
    transform: scaleX(1);
  }

  /* Cargos escalonados: a progressão dentro de uma empresa é justamente o que
     aquelas três linhas contam. */
  .timeline.is-tracking .timeline__roles li {
    opacity: 0;
    transform: translateX(-0.4rem);
    transition:
      opacity 300ms ease-out,
      transform 300ms ease-out;
  }

  .timeline.is-tracking .timeline__roles li:nth-child(2) {
    transition-delay: 90ms;
  }

  .timeline.is-tracking .timeline__roles li:nth-child(3) {
    transition-delay: 180ms;
  }

  .timeline.is-tracking .timeline__entry.is-reached .timeline__roles li {
    opacity: 1;
    transform: translateX(0);
  }

  /* A nota fecha a sequência, depois dos cargos. Ela ficava de fora e era a
     única coisa da parada que aparecia sem transição nenhuma. */
  .timeline.is-tracking .timeline__note {
    opacity: 0;
    transform: translateX(-0.4rem);
    transition:
      opacity 300ms ease-out 240ms,
      transform 300ms ease-out 240ms;
  }

  .timeline.is-tracking .timeline__entry.is-reached .timeline__note {
    opacity: 1;
    transform: translateX(0);
  }

  .timeline__period {
    color: var(--color-accent-deep);
  }

  .timeline__company {
    font-size: var(--font-size-lg);
  }

  .timeline__roles {
    padding: 0;
    list-style: none;
  }

  .timeline__roles li {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-1);
    align-items: baseline;
  }

  .timeline__role-period {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-ink-soft);
  }

  .timeline__note {
    font-size: var(--font-size-sm);
    color: var(--color-ink-soft);
    margin-block-start: var(--space-1);
  }

  /* ---------- formação ---------- */

  /*
   * Lista simples, como era antes da linha de rastreamento.
   *
   * A formação usava as mesmas classes da trajetória e herdou a linha sem que
   * isso tivesse sido decidido. São coisas diferentes: a trajetória é um
   * percurso com paradas, a formação é uma lista de dois itens concluídos.
   * As classes internas continuam compartilhadas — muda o continente, não a
   * tipografia.
   */
  .records {
    display: grid;
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .records__entry {
    padding-inline-start: var(--space-2);
    border-inline-start: 2px solid var(--color-line-strong);
  }

  /* ---------- rodapé ---------- */

  .contact__links {
    margin-block-start: var(--space-2);
  }

  .footer {
    padding-block: var(--space-4);
    border-block-start: 1px solid var(--color-line-strong);
  }

  .footer__credit {
    margin-block-start: var(--space-1);
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .hero__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  @media (min-width: 48rem) {
    .hero__top {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-1) var(--space-2);
    }

    .hero__nav {
      order: 0;
      align-self: auto;
    }

    .hero__body {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
    }

    /*
     * A caixa que segura o objeto se estende para dentro da seção seguinte.
     *
     * `position: sticky` só se move dentro do bloco que contém o elemento. Sem
     * esse alongamento, o objeto descolaria assim que o hero saísse da tela —
     * que é justamente o momento em que ele deveria ficar parado.
     *
     * O padding cria o alcance; a margem negativa de mesmo valor cancela o
     * efeito no layout, então nada abaixo é empurrado.
     */
    .hero__aside {
      /*
       * O tamanho vive AQUI, não no .terrarium. Envolver o objeto fez do aside
       * o item flex — e sem regra de flex ele encolhe, levando junto qualquer
       * largura percentual que o filho declare, porque a porcentagem passa a
       * valer contra a caixa encolhida.
       */
      flex: 0 0 auto;
      width: 48rem;
      max-width: 64%;
    }
  }

  /* ---------- telas maiores ---------- */

  @media (min-width: 48rem) {
    .shell {
      padding-inline: var(--space-4);
    }

    .cards--scattered > li:nth-child(6n + 1) .card {
      --tilt: -1.5deg;
      --shift-x: -0.35rem;
      --shift-y: 0.3rem;
    }

    .cards--scattered > li:nth-child(6n + 2) .card {
      --tilt: 1.2deg;
      --shift-x: 0.4rem;
      --shift-y: -0.25rem;
    }

    .cards--scattered > li:nth-child(6n + 3) .card {
      --tilt: 0.6deg;
      --shift-x: -0.2rem;
      --shift-y: -0.4rem;
    }

    .cards--scattered > li:nth-child(6n + 4) .card {
      --tilt: -0.9deg;
      --shift-x: 0.25rem;
      --shift-y: 0.45rem;
    }

    .cards--scattered > li:nth-child(6n + 5) .card {
      --tilt: 1.6deg;
      --shift-x: -0.3rem;
      --shift-y: -0.15rem;
    }

    .cards--scattered > li:nth-child(6n + 6) .card {
      --tilt: -0.4deg;
      --shift-x: 0.15rem;
      --shift-y: 0.2rem;
    }

    .hero {
      padding-block: var(--space-6) var(--space-8);
    }

    .cards {
      grid-template-columns: repeat(2, 1fr);
    }


    .records__entry {
      display: grid;
      grid-template-columns: 12rem 1fr;
      gap: 0 var(--space-2);
    }

    /*
     * No desktop a linha passa ENTRE as datas e o conteúdo, e não à esquerda de
     * tudo. `--track-x` é a posição da linha; a coluna das datas termina antes
     * dela e o conteúdo começa depois, com o marcador centrado em cima.
     */
    .timeline {
      --track-x: 11rem;

      padding-inline-start: 0;
    }

    /* As DUAS linhas, base e progresso. Mover só uma deixa a linha desenhada
       num eixo e a apagada noutro. */
    .timeline::before,
    .timeline::after {
      inset-inline-start: var(--track-x);
    }

    .timeline__entry {
      display: grid;
      grid-template-columns: 10.25rem 1fr;
      column-gap: 1.5rem;
      padding-inline-start: 0;
    }

    .timeline__dot {
      /* Metade da largura do marcador (0.625rem) para a esquerda, para o centro
         dele cair exatamente sobre a linha. */
      inset-inline-start: calc(var(--track-x) - 0.3125rem);
    }

    .timeline__entry::after {
