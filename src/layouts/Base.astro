---
import { profile } from '../lib/content/profile.ts';
import { cssVariables } from '../lib/design/css-variables.ts';
import { markUnderline } from '../lib/design/mark-underline.ts';
import { tokens } from '../lib/design/tokens.ts';
import { localePath } from '../lib/i18n/locale-path.ts';
import { defaultLocale, type Locale, locales } from '../lib/i18n/locales.ts';
import { redirectTarget } from '../lib/i18n/redirect-target.ts';
import { ui } from '../lib/i18n/ui.ts';
import { personSchemaJson } from '../lib/seo/person-schema.ts';
import { LOCALE_KEY } from '../scripts/language/remember-choice.ts';
import { shouldRunFallback } from '../scripts/motion/scroll-motion.ts';
import '../styles/fonts.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  locale: Locale;
}

const { title, description, locale } = Astro.props;
const { pathname } = Astro.url;

// As custom properties saem dos mesmos tokens que os testes de contraste leem.
const variables = cssVariables(tokens);

// O traço das palavras marcadas nasce do mesmo token de cor que todo o resto.
const markRule = `--mark-underline: ${markUnderline(tokens.color.accent)};`;

const canonical = new URL(localePath(pathname, locale), Astro.site).href;

/*
 * Imagem de compartilhamento, uma por idioma — é ela que aparece no LinkedIn e
 * no WhatsApp. Gerada por tools/build-icons.mjs a partir dos mesmos tokens e da
 * mesma tipografia do site, e commitada em public/.
 *
 * A URL precisa ser absoluta: nenhum agregador resolve caminho relativo aqui.
 */
const ogImage = new URL(locale === 'en' ? '/og-en.png' : '/og.png', Astro.site).href;

/*
 * Dados estruturados sobre a pessoa.
 *
 * Montados a partir de profile.ts e timeline.ts, então cargo, empregador e
 * perfis não existem numa segunda cópia aqui — um dado desatualizado neste
 * bloco só apareceria meses depois, num resultado de busca.
 */
const personJson = personSchemaJson({ site: Astro.site?.href ?? canonical, locale });

const alternates = locales.map((option) => ({
  hreflang: option,
  href: new URL(localePath(pathname, option), Astro.site).href,
}));

/*
 * Decisão do fallback de animação, inline e bloqueante pela mesma razão da
 * detecção de idioma: se a classe entrasse depois da primeira pintura, o
 * conteúdo apareceria e sumiria na frente do usuário.
 *
 * `shouldRunFallback` é serializada com toString() — é a mesma função coberta
 * pelos testes, e não uma segunda cópia da regra escrita à mão aqui.
 */
const motionFallback = `
(function () {
  var decide = ${shouldRunFallback.toString()};
  var run = decide({
    supportsScrollTimeline: CSS.supports('animation-timeline', 'view()'),
    reducedMotion: matchMedia('(prefers-reduced-motion: reduce)').matches,
  });
  if (run) document.documentElement.classList.add('js-motion');
})();
`.trim();

/*
 * Detecção de idioma.
 *
 * Roda inline e de forma bloqueante no <head>, de propósito: um script diferido
 * redirecionaria depois da primeira pintura, e o usuário veria a página piscar
 * do português para o inglês.
 *
 * A função vem de redirectTarget, serializada com toString() — é literalmente o
 * mesmo código coberto pelos testes, em vez de uma segunda cópia da regra
 * escrita à mão aqui dentro, que sairia de sincronia sem ninguém notar.
 */
const detection = `
(function () {
  var saved = null;
  try { saved = localStorage.getItem(${JSON.stringify(LOCALE_KEY)}); } catch (e) {}
  var decide = ${redirectTarget.toString()};
  var target = decide(location.pathname, navigator.languages || [], saved);
  if (target) location.replace(target + location.search + location.hash);
})();
`.trim();
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!--
      SVG primeiro: escala em qualquer densidade e pesa 700 bytes. O PNG existe
      porque o Safari no iOS ignora favicon.svg, e o apple-touch-icon porque
      atalho na tela inicial usa outro tamanho e não aceita transparência.
    -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="canonical" href={canonical} />
    {
      alternates.map((alternate) => (
        <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localePath(pathname, defaultLocale), Astro.site).href}
    />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${ui.blogTitle[locale]} — Henrique Artur`}
      href={new URL(locale === 'en' ? '/en/rss.xml' : '/rss.xml', Astro.site).href}
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale.replace('-', '_')} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Henrique Artur — ${profile.tagline[locale]}`} />

    <!--
      O Twitter/X não lê og:image sem saber o formato do cartão, e sem isto
      mostra a miniatura quadradinha em vez da imagem inteira.
    -->
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" is:inline set:html={personJson} />

    <!-- A fonte de corpo é a única no caminho crítico de leitura. -->
    <link
      rel="preload"
      href="/fonts/source-serif-4-400-600-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <style set:html={`:root {\n${variables}${markRule}\n}`}></style>
    <script is:inline set:html={detection} />
    <script is:inline set:html={motionFallback} />
  </head>

  <body>
    <a class="skip-link" href="#conteudo">{ui.skipToContent[locale]}</a>
    <slot />

    <script>
      import {
        clearCentered,
        markCentered,
        revealInView,
      } from '../scripts/motion/scroll-motion.ts';

      const stillMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Duas responsabilidades independentes, com condições diferentes.
      //
      // A revelação é FALLBACK: só entra onde o CSS não sabe fazer sozinho.
      //
      // A marca de "mais centralizado" é o caminho único onde não há cursor, e
      // exige TAMBÉM coluna única: numa grade de duas colunas, "o cartão mais
      // central da tela" é um critério arbitrário — marca um dos dois da fileira
      // e o círculo fica permanente sobre ele. Num tablet em paisagem isso
      // aconteceria de verdade, não só na simulação de toque do navegador.
      const revealables = document.documentElement.classList.contains('js-motion')
        ? [...document.querySelectorAll<HTMLElement>('.reveal, .card-enter, .draw')]
        : [];

      const projectCards = [
        ...document.querySelectorAll<HTMLElement>('#projetos .cards--scattered > li'),
      ];
      const scrollDrawsCircle = matchMedia('(hover: none) and (max-width: 47.99rem)');

      if (revealables.length > 0 || projectCards.length > 0) {
        let scheduled = false;

        const update = () => {
          scheduled = false;

          if (revealables.length > 0) revealInView(revealables, window.innerHeight);

          // Reavaliado a cada quadro: girar o tablet muda a resposta, e a marca
          // precisa sair junto em vez de ficar presa no último cartão.
          if (!stillMotion && scrollDrawsCircle.matches) {
            markCentered(projectCards, window.innerHeight);
          } else {
            clearCentered(projectCards);
          }
        };

        // Um frame por rolagem, no máximo: sem isto o handler roda dezenas de
        // vezes por segundo medindo layout, que é o caminho curto para travar a
        // rolagem no celular.
        const schedule = () => {
          if (scheduled) return;
          scheduled = true;
          requestAnimationFrame(update);
        };

        update();
        addEventListener('scroll', schedule, { passive: true });
        addEventListener('resize', schedule, { passive: true });
      }
    </script>
  </body>
</html>
