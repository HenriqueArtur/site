---
import Section from '../components/Section.astro';
import Base from '../layouts/Base.astro';
import { education } from '../lib/content/education.ts';
import { impact } from '../lib/content/impact.ts';
import { openSource } from '../lib/content/open-source.ts';
import { profile } from '../lib/content/profile.ts';
import { projects } from '../lib/content/projects.ts';
import { stack } from '../lib/content/stack.ts';
import { timeline } from '../lib/content/timeline.ts';
import { formatPeriod } from '../lib/i18n/format-period.ts';
import { defaultLocale } from '../lib/i18n/locales.ts';

// A fase 4 troca isto pela rota. Todo o conteúdo já existe nos dois idiomas.
const locale = defaultLocale;

const t = {
  about: 'Sobre',
  aboutTitle: 'Quem eu sou',
  impact: 'Impacto',
  impactTitle: 'O que mudou porque eu estava lá',
  projects: 'Construído',
  projectsTitle: 'Sistemas que eu ajudei a existir',
  stack: 'Stack',
  stackTitle: 'Com o que eu trabalho',
  stackPast: 'Já trabalhei com',
  openSource: 'Open source',
  openSourceTitle: 'O que eu mantenho no aberto',
  timeline: 'Trajetória',
  timelineTitle: 'Por onde eu passei',
  education: 'Formação',
  educationTitle: 'Onde eu estudei',
  contact: 'Contato',
  contactTitle: 'Vamos conversar',
  contactLead:
    'Aberto a conversas sobre arquitetura, liderança técnica e problemas difíceis. O caminho mais direto é o e-mail.',
};

const featured = openSource.find((repo) => repo.featured);
const others = openSource.filter((repo) => !repo.featured);
---

<Base title={`${profile.name} — ${profile.role[locale]}`} description={profile.tagline[locale]}>
  <div class="shell">
    <header class="hero">
      <p class="label hero__eyebrow">
        {profile.role[locale]} · {profile.location[locale]}
      </p>
      <h1 class="hero__name">{profile.name}</h1>
      <p class="hero__tagline">{profile.tagline[locale]}</p>

      <nav aria-label="Links de contato">
        <ul class="hero__links">
          {
            profile.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main id="conteudo">
      <Section id="sobre" number="01" label={t.about} title={t.aboutTitle}>
        <div class="prose">
          {profile.summary.map((paragraph) => <p>{paragraph[locale]}</p>)}
        </div>
      </Section>

      <Section id="impacto" number="02" label={t.impact} title={t.impactTitle}>
        <ul class="cards">
          {
            impact.map((item) => (
              <li class="card">
                {item.metric && <p class="card__metric">{item.metric[locale]}</p>}
                <h3 class="card__title">{item.title[locale]}</h3>
                <p class="card__text">{item.description[locale]}</p>
              </li>
            ))
          }
        </ul>
      </Section>

      <Section id="projetos" number="03" label={t.projects} title={t.projectsTitle}>
        <ul class="cards">
          {
            projects.map((project) => (
              <li class="card">
                <h3 class="card__title">{project.name[locale]}</h3>
                <p class="label card__context">{project.context}</p>
                <p class="card__text">{project.description[locale]}</p>
                <ul class="tags">
                  {project.tech.map((tech) => (
                    <li class="tag">{tech}</li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ul>
      </Section>

      <Section id="stack" number="04" label={t.stack} title={t.stackTitle}>
        <dl class="stack">
          {
            stack.current.map((group) => (
              <div class="stack__group">
                <dt class="label">{group.label[locale]}</dt>
                <dd>
                  <ul class="tags">
                    {group.items.map((item) => (
                      <li class="tag">{item}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            ))
          }
          <div class="stack__group">
            <dt class="label">{t.stackPast}</dt>
            <dd>
              <ul class="tags">
                {stack.past.map((item) => <li class="tag tag--muted">{item}</li>)}
              </ul>
            </dd>
          </div>
        </dl>
      </Section>

      <Section id="open-source" number="05" label={t.openSource} title={t.openSourceTitle}>
        {
          featured && (
            <article class="featured">
              <h3 class="featured__name">
                <a href={featured.href}>{featured.name}</a>
              </h3>
              <p class="label">{featured.language}</p>
              <p class="featured__text">{featured.description[locale]}</p>
            </article>
          )
        }

        <ul class="cards cards--tight">
          {
            others.map((repo) => (
              <li class="card">
                <h3 class="card__title">
                  <a href={repo.href}>{repo.name}</a>
                </h3>
                <p class="label card__context">{repo.language}</p>
                <p class="card__text">{repo.description[locale]}</p>
              </li>
            ))
          }
        </ul>
      </Section>

      <Section id="trajetoria" number="06" label={t.timeline} title={t.timelineTitle}>
        <ol class="timeline">
          {
            timeline.map((entry) => (
              <li class="timeline__entry">
                <p class="label timeline__period">{formatPeriod(entry.start, entry.end, locale)}</p>
                <h3 class="timeline__company">{entry.company}</h3>
                <ul class="timeline__roles">
                  {entry.roles.map((role) => (
                    <li>
                      <span class="timeline__role">{role.title[locale]}</span>
                      <span class="timeline__role-period">
                        {formatPeriod(role.start, role.end, locale)}
                      </span>
                    </li>
                  ))}
                </ul>
                {entry.note && <p class="timeline__note">{entry.note[locale]}</p>}
              </li>
            ))
          }
        </ol>
      </Section>

      <Section id="formacao" number="07" label={t.education} title={t.educationTitle}>
        <ol class="timeline">
          {
            education.map((degree) => (
              <li class="timeline__entry">
                <p class="label timeline__period">{formatPeriod(degree.start, degree.end, locale)}</p>
                <h3 class="timeline__company">{degree.title[locale]}</h3>
                <p class="timeline__role">{degree.institution}</p>
                {degree.note && <p class="timeline__note">{degree.note[locale]}</p>}
              </li>
            ))
          }
        </ol>
      </Section>

      <Section id="contato" number="08" label={t.contact} title={t.contactTitle}>
        <div class="prose">
          <p>{t.contactLead}</p>
        </div>
        <ul class="hero__links contact__links">
          {
            profile.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </Section>
    </main>

    <footer class="footer">
      <p class="label">© {profile.name}</p>
    </footer>
  </div>
</Base>

<style>
  .shell {
    max-width: var(--layout-max-width);
    padding-inline: var(--space-2);
    margin-inline: auto;
  }

  /* ---------- hero ---------- */

  .hero {
    padding-block: var(--space-8) var(--space-6);
  }

  .hero__eyebrow {
    margin-block-end: var(--space-2);
  }

  .hero__name {
    font-size: var(--font-size-3xl);
    margin-block-end: var(--space-2);
  }

  .hero__tagline {
    max-width: 40ch;
    font-size: var(--font-size-lg);
    color: var(--color-ink-soft);
    margin-block-end: var(--space-3);
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    padding: 0;
    list-style: none;
  }

  /* ---------- cartões ---------- */

  .cards {
    display: grid;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .card {
    padding: var(--space-2);
    background-color: var(--color-paper-deep);
    border: 1px solid var(--color-line-strong);
  }

  .card__metric {
    font-family: var(--font-display);
    font-size: var(--font-size-2xl);
    font-weight: 700;
    line-height: var(--line-height-tight);
    color: var(--color-accent-deep);
  }

  .card__title {
    font-size: var(--font-size-lg);
    margin-block-end: var(--space-1);
  }

  .card__context {
    margin-block-end: var(--space-1);
  }

  .card__text {
    font-size: var(--font-size-sm);
  }

  /* ---------- destaque de open source ---------- */

  .featured {
    padding: var(--space-3);
    color: var(--color-paper);
    background-color: var(--color-ink);
    margin-block-end: var(--space-2);
  }

  .featured :global(.label) {
    color: var(--color-line);
  }

  .featured__name {
    font-size: var(--font-size-xl);
  }

  .featured__name a {
    color: var(--color-paper);
  }

  .featured__text {
    margin-block-start: var(--space-1);
  }

  /* ---------- etiquetas ---------- */

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    padding: 0;
    margin-block-start: var(--space-1);
    list-style: none;
  }

  .tag {
    padding: 0.125rem 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-ink);
    background-color: var(--color-paper);
    border: 1px solid var(--color-line-strong);
  }

  .tag--muted {
    color: var(--color-ink-soft);
    background-color: transparent;
  }

  /* ---------- stack ---------- */

  .stack {
    display: grid;
    gap: var(--space-3);
  }

  .stack__group dd {
    margin-inline-start: 0;
  }

  /* ---------- trajetória ---------- */

  .timeline {
    display: grid;
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .timeline__entry {
    padding-inline-start: var(--space-2);
    border-inline-start: 2px solid var(--color-line-strong);
  }

  .timeline__period {
    color: var(--color-accent-deep);
  }

  .timeline__company {
    font-size: var(--font-size-lg);
  }

  .timeline__roles {
    padding: 0;
    list-style: none;
  }

  .timeline__roles li {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-1);
    align-items: baseline;
  }

  .timeline__role-period {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-ink-soft);
  }

  .timeline__note {
    font-size: var(--font-size-sm);
    color: var(--color-ink-soft);
    margin-block-start: var(--space-1);
  }

  /* ---------- rodapé ---------- */

  .contact__links {
    margin-block-start: var(--space-2);
  }

  .footer {
    padding-block: var(--space-4);
    border-block-start: 1px solid var(--color-line-strong);
  }

  /* ---------- telas maiores ---------- */

  @media (min-width: 48rem) {
    .shell {
      padding-inline: var(--space-4);
    }

    .hero {
      padding-block: var(--space-12) var(--space-8);
    }

    .hero__name {
      font-size: var(--font-size-4xl);
    }

    .hero__tagline {
      font-size: var(--font-size-xl);
    }

    .cards {
      grid-template-columns: repeat(2, 1fr);
    }

    .stack {
      grid-template-columns: repeat(2, 1fr);
    }

    .timeline__entry {
      display: grid;
      grid-template-columns: 12rem 1fr;
      gap: 0 var(--space-2);
    }

    .timeline__period {
      grid-row: 1 / span 3;
    }
  }
</style>
